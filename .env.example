# Server
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/heliotrope
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CLIENT_URL=http://localhost:5173

# Email (Nodemailer)
RESEND_API_KEY=re_your_resend_api_key

# AI Fashion Assistant (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Social OAuth (Facebook/Meta)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/social/oauth/facebook/callback

# Ayrshare (Instagram fallback)
AYRSHARE_API_KEY=your_ayrshare_key

# Client
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000